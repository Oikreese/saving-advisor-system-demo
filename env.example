# OpenAI API (Required)
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration
# Use "sqlite" for quick development start, or "postgres" for production
DB_DRIVER=sqlite  # or "postgres" for production
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=saving_advisor

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Server Ports
SERVER_PORT=50051    # gRPC server port (standard gRPC port)
GATEWAY_PORT=8080   # REST gateway port (HTTP port)

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Saving Advisor System
ENVIRONMENT=development  # development or production
DEBUG=true

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# OpenAI Model
OPENAI_MODEL=gpt-4

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_ANALYTICS_SYNC=true
INITIAL_SYNC_ON_STARTUP=false
SYNC_BATCH_SIZE=100
CACHE_TTL_HOURS=2

# Logging
LOG_LEVEL=INFO

# Monitoring Configuration
ENABLE_MONITORING=true
ENABLE_SSE_MONITORING=true
MONITORING_LITE_MODE=false

# Flower Monitoring (Celery task monitoring)
FLOWER_USER=admin
FLOWER_PASSWORD=admin
